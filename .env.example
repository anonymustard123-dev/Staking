DATABASE_URL=postgres://staking:staking@localhost:5432/staking
PORT=3001
POLL_INTERVAL_MS=120000
STALE_AFTER_MS=600000
BEACON_API_BASE_URL=https://ethereum-beacon-api.publicnode.com
# If using NodeReal, set the full server-side base URL including your API key.
# BEACON_API_BASE_URL=https://eth2-beacon-mainnet.nodereal.io/v1/YOUR_KEY
# Optional server-side authorization header for another Beacon API provider:
# BEACON_API_AUTH_HEADER=Bearer YOUR_TOKEN
# Optional future indexed feeds; not queried by this prototype:
# BEACONCHAIN_API_KEY=
# FIGMENT_API_KEY=

# BOW Supabase durable snapshot store. These values are used only by the
# Vercel server function; never expose the service-role key in browser code.
# Accepts either the project URL or the Data API URL ending in /rest/v1.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
