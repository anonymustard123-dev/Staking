{
  "name": "bny-staking-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --watch --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "collector": "node --env-file-if-exists=.env --experimental-strip-types server/collector.ts",
    "doctor": "node --env-file-if-exists=.env --experimental-strip-types server/doctor.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types server/migrate.ts",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "test": "node --experimental-strip-types --test server/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
